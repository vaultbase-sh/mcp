{
  "name": "@vaultbase/mcp",
  "version": "0.1.1",
  "description": "Stdio↔HTTP bridge for the Vaultbase MCP server — connect Claude Desktop / Cursor / any MCP client to a remote Vaultbase deployment.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "vaultbase-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "vaultbaseServerCompat": ">=0.10 <2.0",
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "vaultbase",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "homepage": "https://docs.vaultbase.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaultbase-sh/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vaultbase-sh/mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "bun-types": "^1.4.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
